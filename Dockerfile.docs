FROM node:26-alpine AS build
ARG QUARTZ_REF=v4.5.2
WORKDIR /quartz
RUN apk add --no-cache git coreutils \
  && git clone --depth 1 --branch "$QUARTZ_REF" https://github.com/jackyzha0/quartz.git . \
  && npm ci
COPY docs-site/quartz.config.ts docs-site/quartz.layout.ts ./
# patched graph script, shadowing the clone's copy - see docs-site/README.md
COPY docs-site/quartz/components/scripts/graph.inline.ts quartz/components/scripts/graph.inline.ts
COPY docs content
RUN npx quartz build

FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY deploy/security-headers-docs.conf /etc/nginx/snippets/security-headers-docs.conf
COPY deploy/nginx-docs.conf /etc/nginx/conf.d/default.conf
COPY --from=build /quartz/public /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
