{
  "compilerOptions": {
    "target": "ES2023",
    // DOM: e2e specs run browser code inside page.evaluate().
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "e2e",
    "tests/architecture.test.ts",
    "tests/gallery-build-flag.test.ts",
    "tests/icons.test.ts",
    "tests/components/answer-controls-layers.test.ts",
    "tests/components/scroll-area-layers.test.ts"
  ]
}
